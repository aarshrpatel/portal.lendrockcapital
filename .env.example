# ── Lendrock Deal OS environment ──────────────────────────────────
# Copy to .env.local for development; set in Vercel for production.

# Session-signing secret (required in production). Generate:
#   openssl rand -hex 32
AUTH_SECRET=

# Database. Dev default is SQLite (prisma/dev.db, no setup needed).
# Production: Neon Postgres — see docs/PRODUCTION.md for the cutover.
# DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# Public lead API throttle (requests/min per IP). Default 5.
# PUBLIC_LEADS_RPM=5

# ── Production integrations (Module 09 §9.5 adapter layer) ────────
# Auth (Clerk) — replaces dev role-switcher at the lib/auth.ts seam
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# CLERK_SECRET_KEY=

# E-sign (Dropbox Sign), bank data (Plaid), ACH (Dwolla), OFAC
# (sanctions.io), KYC/KYB (Persona/Middesk), comms (Postmark/Twilio)
# DROPBOX_SIGN_API_KEY=
# PLAID_CLIENT_ID=
# PLAID_SECRET=
# DWOLLA_KEY=
# DWOLLA_SECRET=
# SANCTIONS_IO_API_KEY=
# POSTMARK_TOKEN=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
